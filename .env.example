# Скопируй в .env и заполни. Файл .env в git НЕ коммитится.

# Домен панели (например, из DuckDNS). На него Caddy автоматически
# получит HTTPS-сертификат. Должен указывать на IP этого сервера.
PANEL_DOMAIN=example.duckdns.org

# Часовой пояс для расписаний (иначе сервер считает по UTC).
TZ=Europe/Moscow

# (необязательно) Ключ подписи сессий входа. Если оставить пустым —
# сгенерируется автоматически и сохранится в profiles/secret.key.
# SECRET_KEY=

# (необязательно) Токен CryptoBot для приёма оплаты криптой.
# Получить: Telegram → @CryptoBot → Crypto Pay → Create App → API Token.
# Без него подписки работают, но оплату продлеваешь вручную в админке.
# CRYPTOBOT_TOKEN=

# (необязательно) Проверка оплат в рабочих диалогах. Значения по умолчанию
# подходят для обычной работы, адрес OCR задан в docker-compose.yml.
# Факты, суммы и решения, как и полный зашифрованный чат, по умолчанию хранятся
# до ручного удаления владельца/архива. Положительное число включает автоочистку:
# PAYMENT_FACT_RETENTION_DAYS=0
# PAYMENT_CHAT_ARCHIVE_RETENTION_DAYS=0
# Защита диска: максимум на владельца / на весь сервис и неснижаемый запас:
# PAYMENT_CHAT_ARCHIVE_OWNER_BYTES=536870912
# PAYMENT_CHAT_ARCHIVE_GLOBAL_BYTES=2147483648
# PAYMENT_CHAT_ARCHIVE_MIN_FREE_BYTES=536870912
# Отдельный ключ полного архива (64 hex-символа). Если не задан, панель создаст
# profiles/payment_archive.key; в продакшене лучше задать ключ здесь и хранить
# резервную копию .env отдельно от бэкапа profiles/.
# PAYMENT_ARCHIVE_KEY=
# Лимит распознаваний чеков на аккаунт в час и глубина очереди:
# PAYMENT_AUDIT_OCR_PER_HOUR=30
# PAYMENT_AUDIT_OCR_QUEUE_MAX=20
