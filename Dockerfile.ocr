FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       tesseract-ocr tesseract-ocr-rus tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && tesseract --list-langs 2>/dev/null | grep -qx rus \
    && tesseract --list-langs 2>/dev/null | grep -qx eng

WORKDIR /app

COPY requirements-ocr.txt .
RUN pip install --no-cache-dir -r requirements-ocr.txt

# No bot source, profiles, sessions, env file, or Poppler is present here.
COPY receipt_ocr.py ocr_service.py ./

USER 65532:65532

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3).read()"]

CMD ["uvicorn", "ocr_service:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
